# ===== AI 摘要（至少选一个） =====
# Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx
# OpenAI API: https://platform.openai.com 或任何兼容 API（如 DeepSeek、通义千问等）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=claude-sonnet-4-6

# ===== 推送通道（选填，填哪个开哪个） =====

# 邮件（推荐 QQ邮箱，需开启 SMTP 获取授权码）
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your@qq.com
EMAIL_PASS=授权码
EMAIL_TO=receive1@example.com,receive2@example.com

# 微信推送 —— Server酱 (https://sct.ftqq.com)
SCT_KEY=SCT123456xxx

# QQ推送 —— Qmsg酱 (https://qmsg.zendee.cn)
QMSG_KEY=xxx

# 通用 Webhook（企业微信机器人 / Discord / Slack 等）
# WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
